PORT=3000
OCR_PROVIDER=paddle
USE_MOCK_OCR=false
PADDLE_PYTHON=.venv/bin/python
PADDLE_PDX_CACHE_HOME=.paddle-cache
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_HTML_MODEL=qwen2.5vl:7b

# Optional OpenAI-compatible local vision endpoints for HTML reconstruction.
# Keep PaddleOCR and Ollama as-is; use these routes to compare newer vision models:
# POST /reconstruct-html/qwen
# POST /reconstruct-html/glm
# POST /reconstruct-html/ai
# POST /reconstruct-html/openrouter
QWEN_VL_URL=http://127.0.0.1:11434/v1/chat/completions
QWEN_VL_MODEL=qwen2.5vl:7b
QWEN_VL_API_KEY=

GLM_VL_URL=http://127.0.0.1:11434/v1/chat/completions
GLM_VL_MODEL=glm-ocr:latest
GLM_VL_API_KEY=

GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/interactions
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FILL_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=

OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_MODELS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-nano-12b-v2-vl:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Image2HTML AI

# The extension's Generate with AI button calls the same backend route, and this
# setting decides which hosted vision provider serves it.
# Use gemini, openrouter, qwen, or glm.
AI_VISION_PROVIDER=gemini
AI_VISION_FALLBACK_PROVIDER=

FREE_DAILY_AI_CALLS=10
AI_USAGE_TIME_ZONE=Asia/Kolkata
# Deprecated compatibility fallback. Prefer FREE_DAILY_AI_CALLS.
FREE_DAILY_GEMINI_CALLS=10
ADMIN_API_KEY=

# Supabase usage tracking. Use the service role key only on the backend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Insert manual AI quota overrides with:
# npm run quota:override -- --device-id=<extension-device-id> --provider=gemini --extra-uses=5
# npm run quota:override -- --device-id=<extension-device-id> --provider=openai --daily-limit=25 --usage-date=2026-07-30
